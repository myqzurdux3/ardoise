<?xml version="1.0" encoding="utf-8"?>
<!--
  Declaring the shipped locales puts Ardoise in Settings > Apps > Ardoise >
  Language on Android 13 and later, so a French phone can run the app in
  English without changing the whole system language.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:defaultLocale="en"
    tools:targetApi="35">
    <locale android:name="en" />
    <locale android:name="fr" />
</locale-config>
