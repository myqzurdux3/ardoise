<resources>
    <string name="tagline">Vos tâches, sur l\'écran de verrouillage</string>

    <!-- Compte Google -->
    <string name="section_account">Compte Google</string>
    <string name="account_body">Ardoise lit vos listes Google Tasks. Aucun jeton d\'accès n\'est conservé, et rien n\'est envoyé ailleurs qu\'à l\'API de Google. La liste en cache reste sur cet appareil : elle est exclue de la sauvegarde cloud et du transfert d\'appareil.</string>
    <string name="action_connect">Connecter Google Tasks</string>

    <!-- Configuration requise -->
    <string name="section_setup">Configuration requise</string>
    <string name="setup_body">Google ne reconnaît pas cette version. Ardoise a besoin d\'un identifiant OAuth de type <b>Android</b> enregistré dans Google Cloud Console pour exactement ces deux valeurs, dans un projet où l\'API Tasks est activée.</string>
    <string name="setup_package">Nom du package</string>
    <string name="setup_sha1">Empreinte SHA-1</string>
    <string name="setup_sha1_unavailable">indisponible</string>
    <string name="action_copy">Copier</string>

    <!-- Liste -->
    <string name="section_list">Liste affichée</string>
    <string name="list_empty">Aucune liste trouvée.</string>

    <!-- Permission de notification -->
    <string name="section_notifications_blocked">Notifications bloquées</string>
    <string name="notifications_blocked_body">Sans autorisation de notification, la surface principale d\'Ardoise ne peut pas s\'afficher.</string>
    <string name="action_allow">Autoriser</string>

    <!-- Surfaces -->
    <string name="section_surfaces">Surfaces</string>
    <string name="surface_notification">Notification permanente</string>
    <string name="surface_notification_detail">Six à huit lignes, avec un bouton pour cocher sans déverrouiller.</string>
    <string name="surface_wallpaper">Fond d\'écran de verrouillage</string>
    <string name="surface_wallpaper_detail">Remplace votre fond d\'écran de verrouillage. En désactivant, on revient au fond d\'écran d\'accueil : une image posée séparément sur l\'écran de verrouillage ne peut pas être récupérée.</string>
    <string name="surfaces_visibility_hint">Pensez à régler Notifications sur l\'écran de verrouillage sur « Afficher tout le contenu », sinon le système masque le texte.</string>

    <!-- Affichage et synchronisation -->
    <string name="section_lines">Lignes affichées</string>
    <string name="section_sync">Fréquence de synchronisation</string>
    <string name="sync_polling_note">L\'API Google Tasks n\'envoie aucune notification de changement. Ardoise interroge donc le serveur à intervalle régulier.</string>
    <string name="action_refresh_now">Actualiser maintenant</string>
    <string name="minutes_format">%1$d min</string>

