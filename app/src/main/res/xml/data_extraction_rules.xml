<?xml version="1.0" encoding="utf-8"?>
<!--
  See backup_rules.xml: the cached task list must not leave the device, so the
  DataStore file is excluded from both cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
